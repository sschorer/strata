{
  "name": "strata",
  "version": "0.0.0",
  "private": true,
  "description": "A modular git & code-analysis workbench: hotspots, commit analytics, per-language dependency/dead-code modules, and pluggable AI providers.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @strata/server dev",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.16.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.3"
  }
}
