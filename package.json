{
  "name": "strata",
  "version": "0.0.0",
  "private": true,
  "description": "A modular git & code-analysis workbench: hotspots, commit analytics, per-language dependency/dead-code modules, and configurable AI providers.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @strata/server dev",
    "dev:web": "pnpm --filter @strata/web dev",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
