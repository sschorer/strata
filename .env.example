# Copy to .env and fill in. Never commit .env (it's gitignored).

# HTTP port for @strata/server
PORT=4000

# Directory of repositories to analyse (mounted read-only into the container)
STRATA_REPOS_DIR=./repos

# --- AI provider (optional) -------------------------------------------------
# Works with any OpenAI-compatible endpoint. Examples:
#   OpenAI:     AI_BASE_URL=https://api.openai.com/v1
#   Ollama:     AI_BASE_URL=http://localhost:11434/v1   (AI_API_KEY can be blank)
#   Anthropic:  use a dedicated provider plugin (native API), see plugins/ai-provider-template
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
